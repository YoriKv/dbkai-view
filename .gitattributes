# Enforce LF everywhere. This repository is edited from both Windows and WSL;
# without this, Windows tooling can rewrite files to CRLF and produce noisy,
# cross-platform diffs.
* text=auto eol=lf

# Game data and anything extracted from it is byte-exact input to the
# extractor. `text=auto` would normally detect these as binary anyway, but a
# mis-detection would silently corrupt a fixture, so mark them explicitly.
*.nds  -text
*.dsa  -text
*.dse  -text
*.dsez -text
*.dse7 -text
*.dsdz -text
*.bin  -text

# App assets.
*.png  -text
*.ico  -text
*.icns -text

# Lockfile is managed by uv; keep it as-is.
uv.lock linguist-generated=true
