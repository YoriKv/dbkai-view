# direnv config — https://direnv.net
# Auto-selects this project's WSL/Linux virtualenv whenever you cd into the repo,
# so a bare `uv sync` / `uv run` targets .venv-linux instead of .venv (the
# Windows env). Run `direnv allow` once to trust this file.
#
# Only takes effect where direnv is installed (i.e. WSL/Linux); it is inert on
# Windows, which uses the default .venv and doesn't need this.
export UV_PROJECT_ENVIRONMENT=.venv-linux

# Put the Linux venv's tools on PATH so `python`, `pytest` and `ruff` work
# inside the project without the `uv run` prefix. (PATH_add is a no-op until the
# venv exists — run `uv sync` first.)
PATH_add .venv-linux/bin

# bun's global bin, where `qmd` is installed. ~/.bashrc adds it only for
# interactive shells, so anything else would find no `qmd` without this.
#
# An `if` rather than `[ -d … ] && …`, because this is the last line of the file
# and direnv reports the exit status of the whole thing: on a machine without
# bun the test is false, .envrc exits 1, and every `cd` into the repo prints an
# error. Inert has to mean silent.
if [ -d "$HOME/.bun/bin" ]; then
	PATH_add "$HOME/.bun/bin"
fi
